<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="433.0" prefWidth="590.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.logInController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

   <VBox fillWidth="false" prefHeight="470.0" prefWidth="550.0" spacing="10.0">
      <children>
         <Label alignment="TOP_LEFT" text="Enter your email:" />
         <TextField fx:id="emailField" prefHeight="26.0" prefWidth="284.0" />
         <Label prefHeight="18.0" prefWidth="114.0" text="Enter your password:" />
         <PasswordField fx:id="passwordField" />
         <Button mnemonicParsing="false" onAction="#onHelloButtonClick" text="log in" />
         <Label fx:id="wrong" prefHeight="18.0" prefWidth="189.0" text="email or password is wrong" textFill="RED" visible="false" />
      </children>
   </VBox>
   <Accordion />
   <Accordion />
</VBox>
